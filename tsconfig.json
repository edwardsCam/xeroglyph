{
	"compilerOptions": {
		"target": "esnext",
		"moduleResolution": "node",
		"allowJs": true,
		"jsx": "react",
		"noEmit": true,
		"strict": true,
		"isolatedModules": true,
		"esModuleInterop": true,
		"noImplicitAny": false,
		"noImplicitThis": false,
		"allowSyntheticDefaultImports": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"types": ["node", "react"],
		"skipLibCheck": true,
		"baseUrl": "./",
    "paths": {
      "*": ["*", "src/*"]
    }
	},
	"include": ["src"],
	"exclude": [
    "assets",
		"coverage",
		"dist",
		"template.ts"
	],
}
